<Window x:Class="TerraGeo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TerraGeo Inženjering" Height="720" Width="1200"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
              Foreground="{StaticResource Fg}">
            <MenuItem Header="_Projekat">
                <MenuItem Header="_Novi projekat" Click="OnNewProject"/>
                <MenuItem Header="_Otvori projekat…" Click="OnOpenProject"/>
                <MenuItem Header="_Sačuvaj kao…" Click="OnSaveAs"/>
                <Separator/>
                <MenuItem Header="_Izlaz" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Tačke">
                <MenuItem Header="_Dodaj tačku…" Click="OnAddPoint"/>
                <MenuItem Header="_Obriši izabranu" Click="OnDeletePoint"/>
                <Separator/>
                <MenuItem Header="_Helmert 7-param (demo)…" Click="OnHelmert"/>
            </MenuItem>
            <MenuItem Header="_Pomoć">
                <MenuItem Header="_O programu" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Background="{StaticResource PanelBg}">
                <Button Content="Novi"          Click="OnNewProject"    Padding="10,3"/>
                <Button Content="Otvori"        Click="OnOpenProject"   Padding="10,3"/>
                <Button Content="Sačuvaj kao"   Click="OnSaveAs"         Padding="10,3"/>
                <Separator/>
                <Button Content="Dodaj tačku"   Click="OnAddPoint"       Padding="10,3"/>
                <Button Content="Obriši"        Click="OnDeletePoint"   Padding="10,3"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource PanelBg}"
                   Foreground="{StaticResource Fg}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Spremno."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="TerraGeo Inženjering — "/>
                    <Run Text="Designed by Vladimir Djokich" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False"
                  Background="{StaticResource PanelBg}"
                  Foreground="{StaticResource Fg}"
                  RowBackground="{StaticResource PanelBg}"
                  AlternatingRowBackground="#2D2D30"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3E3E42">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"   Binding="{Binding PointId}"             Width="120"/>
                <DataGridTextColumn Header="X"    Binding="{Binding X, StringFormat=F3}"  Width="140"/>
                <DataGridTextColumn Header="Y"    Binding="{Binding Y, StringFormat=F3}"  Width="140"/>
                <DataGridTextColumn Header="Z"    Binding="{Binding ZDisplay}"            Width="120"/>
                <DataGridTextColumn Header="Kod"  Binding="{Binding Code}"                Width="100"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}"         Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
