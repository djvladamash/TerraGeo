<Window x:Class="TerraGeo.PointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova tačka" Height="380" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Point ID:" Foreground="{StaticResource Fg}" Margin="0,6"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbPointId" Margin="0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="X:" Foreground="{StaticResource Fg}" Margin="0,6"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbX" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Y:" Foreground="{StaticResource Fg}" Margin="0,6"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbY" Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Z (opciono):" Foreground="{StaticResource Fg}" Margin="0,6"/>
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TbZ" Margin="0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Kod:" Foreground="{StaticResource Fg}" Margin="0,6"/>
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbCode" Margin="0,4"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Opis:" Foreground="{StaticResource Fg}" Margin="0,6"/>
        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TbDesc" Margin="0,4"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Otkaži" Width="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Dodaj"  Width="90" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
